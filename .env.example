# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Paystack ─────────────────────────────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here

# ─── Supabase Edge Functions (server-side only, never exposed to browser) ─────
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Termii SMS / WhatsApp (optional — for notification engine) ───────────────
TERMII_API_KEY=your-termii-api-key-here
TERMII_SENDER_ID=AeroLogist

# ─── Resend (optional — for email invoices and statements) ───────────────────
RESEND_API_KEY=your-resend-api-key-here
